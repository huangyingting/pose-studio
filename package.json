{
  "name": "pose-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "NEXT_OUTPUT=export next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "setup:mediapipe": "node scripts/setup-mediapipe.mjs",
    "postinstall": "node scripts/setup-mediapipe.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.61.0",
    "mediabunny": "^1.62.1",
    "next": "^16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "description": "Posable 3D art mannequin for drawing reference, with line-art pose sheet export",
  "engines": {
    "node": ">=20.9"
  }
}
