{
  "name": "filmstudio",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "NEXT_OUTPUT=export next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:slow": "vitest run --project slow",
    "test:related": "vitest run --project unit --changed",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:slow",
    "setup:mediapipe": "node scripts/setup-mediapipe.mjs",
    "motions": "jiti scripts/library-motions.ts",
    "postinstall": "prisma generate && node scripts/setup-mediapipe.mjs",
    "db:migrate": "prisma migrate deploy",
    "sets": "jiti scripts/sets.ts",
    "set-thumbs": "jiti scripts/set-thumbs.ts",
    "thumbs": "jiti scripts/thumbs.ts",
    "doc-shots": "jiti scripts/doc-shots.ts",
    "knip": "knip"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dimforge/rapier3d": "^0.21.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.61.0",
    "mediabunny": "^1.62.1",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "three": "^0.187.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "jiti": "^2.7.0",
    "knip": "^6.44.1",
    "meshoptimizer": "^1.3.0",
    "prisma": "^7.10.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.5"
  },
  "description": "Film Studio: block and film scenes with posable 3D people, and a posable mannequin for drawing reference",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
