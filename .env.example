# Server edition configuration (copy to .env). The static edition (GitHub Pages) needs none of this.

# Public URL of the app, and a long random secret for sessions (e.g. `openssl rand -base64 32`).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# SQLite database (the Docker image keeps it on the /data volume).
DATABASE_URL=file:./data/pose-studio.db
# Imported motions, one file each (default: assets/ next to the database)
# ASSETS_DIR=./data/assets

# Sign-in: each provider is offered when its credentials are set.
# Google: redirect URI {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra ID: redirect URI {NEXTAUTH_URL}/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# AI assistant (Responses API): Azure OpenAI, or OpenAI.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Model requests per user per day (each assistant step is one).
AI_DAILY_LIMIT=200

# Automated tests only: a password-less "Test account" sign-in. Never set this on a public server.
# AUTH_TEST_LOGIN=1
